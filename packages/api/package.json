{
  "name": "@app/api",
  "version": "0.1.0",
  "description": "API NestJS — auth, permissões, sync e domínio de cobrança.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../database/prisma/schema.prisma",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:integracao": "node test/integracao-harness.js",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../database/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema ../database/prisma/schema.prisma",
    "prisma:migrate:baseline": "prisma migrate resolve --applied 0_init --schema ../database/prisma/schema.prisma",
    "prisma:migrate:verify": "prisma migrate diff --from-empty --to-schema-datamodel ../database/prisma/schema.prisma --script",
    "lint": "eslint src"
  },
  "dependencies": {
    "@app/core": "*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.12.0",
    "argon2": "^0.40.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "@nestjs/schedule": "^4.0.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "prisma": "^5.12.0",
    "typescript": "^5.4.0",
    "@nestjs/testing": "^10.3.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "ts-jest": "^29.1.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/pdfkit": "^0.13.4"
  }
}
