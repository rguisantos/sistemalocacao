# Banco
DATABASE_URL="postgresql://usuario:senha@localhost:5432/locacoes?schema=public"
# JWT — secret obrigatório, >= 32 chars. NUNCA versionar o valor real.
JWT_SECRET="troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Redis (rate limiting persistente — compartilhado entre instâncias)
REDIS_URL="redis://localhost:6379"
# Operação
FUSO_OPERACAO="America/Sao_Paulo"
PORT=3000

# Criptografia de credenciais (Mercado Pago etc.) — >= 32 chars
CONFIG_SECRET="outro-segredo-aleatorio-de-32-ou-mais-caracteres"
